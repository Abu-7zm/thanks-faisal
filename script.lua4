-- ==========================================
-- ALPHA XK - V12 (ULTIMATE NO-LAG)
-- ==========================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local ESP_Enabled = false
local Aimbot_Enabled = false
local CarSpeed = 300
local CurrentTargets = {}

-- UI Creation
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AlphaHunterV12"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = game.CoreGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 320, 0, 200)
MainFrame.Position = UDim2.new(0, 50, 0, 100)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
MainFrame.BorderSizePixel = 2
MainFrame.BorderColor3 = Color3.fromRGB(0, 255, 0)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Title.Text = "ALPHA XK - V12"
Title.TextColor3 = Color3.fromRGB(0, 255, 0)
Title.Font = Enum.Font.SourceSansBold
Title.Parent = MainFrame

local ToggleESP = Instance.new("TextButton")
ToggleESP.Size = UDim2.new(0.45, 0, 0, 30)
ToggleESP.Position = UDim2.new(0.03, 0, 0, 40)
ToggleESP.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
ToggleESP.Text = "ESP: OFF"
ToggleESP.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleESP.Parent = MainFrame

local ToggleAimbot = Instance.new("TextButton")
ToggleAimbot.Size = UDim2.new(0.45, 0, 0, 30)
ToggleAimbot.Position = UDim2.new(0.52, 0, 0, 40)
ToggleAimbot.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
ToggleAimbot.Text = "Aimbot: OFF"
ToggleAimbot.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleAimbot.Parent = MainFrame

local SpeedBox = Instance.new("TextBox")
SpeedBox.Size = UDim2.new(0.9, 0, 0, 30)
SpeedBox.Position = UDim2.new(0.05, 0, 0, 90)
SpeedBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
SpeedBox.Text = "300"
SpeedBox.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBox.Parent = MainFrame

SpeedBox.FocusLost:Connect(function() CarSpeed = tonumber(SpeedBox.Text) or 300 end)

ToggleESP.MouseButton1Click:Connect(function()
    ESP_Enabled = not ESP_Enabled
    ToggleESP.Text = "ESP: " .. (ESP_Enabled and "ON" or "OFF")
    ToggleESP.BackgroundColor3 = ESP_Enabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)
end)

ToggleAimbot.MouseButton1Click:Connect(function()
    Aimbot_Enabled = not Aimbot_Enabled
    ToggleAimbot.Text = "Aimbot: " .. (Aimbot_Enabled and "ON" or "OFF")
    ToggleAimbot.BackgroundColor3 = Aimbot_Enabled and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(50, 50, 50)
end)

-- Scan Loop (Safe & Optimized)
task.spawn(function()
    while task.wait(1) do
        if ESP_Enabled or Aimbot_Enabled then
            local found = {}
            pcall(function()
                for _, obj in pairs(Workspace:GetChildren()) do
                    if obj:IsA("Model") then
                        local isPlayer = false
                        for _, plr in pairs(Players:GetPlayers()) do
                            if plr.Character == obj then isPlayer = true; break end
                        end
                        
                        if not isPlayer then
                            local hasHumanoid = obj:FindFirstChild("Humanoid")
                            local hasPrompt = obj:FindFirstChild("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                            
                            if hasHumanoid or hasPrompt then
                                local targetPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
                                if targetPart then
                                    table.insert(found, targetPart)
                                end
                            end
                        end
                    end
                end
            end)
            CurrentTargets = found
        else
            CurrentTargets = {}
        end
    end
end)

-- Render Loop (ESP & Aimbot)
RunService.RenderStepped:Connect(function()
    -- Clean old highlights
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChild("AlphaHL") then
            obj.AlphaHL:Destroy()
        end
    end

    if ESP_Enabled and #CurrentTargets > 0 then
        for _, targetPart in ipairs(CurrentTargets) do
            local parent = targetPart.Parent
            if parent and not parent:FindFirstChild("AlphaHL") then
                local hl = Instance.new("Highlight")
                hl.Name = "AlphaHL"
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.Parent = parent
            end
        end
    end
    
    if Aimbot_Enabled and #CurrentTargets > 0 then
        local closest = nil
        local shortest = math.huge
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

        for _, targetPart in ipairs(CurrentTargets) do
            local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            if onScreen then
                local distToCenter = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if distToCenter < shortest then
                    shortest = distToCenter
                    closest = targetPart
                end
            end
        end

        if closest then
            local targetCFrame = CFrame.new(Camera.CFrame.Position, closest.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.25)
        end
    end
end)

-- Car Speed (Modern Physics)
local carVelocity = nil
task.spawn(function()
    while task.wait(0.1) do
        local seat = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("VehicleSeat")
        if seat and seat.Occupant == LocalPlayer.Character.Humanoid then
            local carModel = seat:FindFirstAncestorOfClass("Model") or seat.Parent
            local chassis = carModel.PrimaryPart or carModel:FindFirstChildWhichIsA("BasePart")
            
            if chassis then
                if not carVelocity or carVelocity.Parent ~= chassis then
                    if carVelocity then carVelocity:Destroy() end
                    carVelocity = Instance.new("LinearVelocity")
                    carVelocity.Name = "AlphaCarSpeed"
                    carVelocity.MaxForce = math.huge
                    carVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Line
                    carVelocity.LineDirection = chassis.CFrame.LookVector
                    carVelocity.Parent = chassis
                end
                carVelocity.LineDirection = chassis.CFrame.LookVector
                carVelocity.LineVelocity = CarSpeed
            end
        else
            if carVelocity then carVelocity:Destroy(); carVelocity = nil end
        end
    end
end)
